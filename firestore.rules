rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      // Anyone can read wishes on the invitation page
      allow read: if true;

      // Guests can add a wish (app limits each guest to 2)
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'guestId'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.guestId is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.guestId.size() > 8
        && request.resource.data.guestId.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Only signed-in couple/admin can edit or delete
      allow update, delete: if request.auth != null;
    }
  }
}
