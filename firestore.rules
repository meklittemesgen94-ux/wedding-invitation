rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'guestId'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.guestId is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.guestId.size() > 8
        && request.resource.data.guestId.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Open edit/delete — matches the invitation page (no sign-in, no PIN)
      allow update: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'guestId'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.guestId == resource.data.guestId;

      allow delete: if true;
    }
  }
}
