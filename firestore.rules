rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'guestId'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.guestId is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.guestId.size() > 8
        && request.resource.data.guestId.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Edit/delete unlocked in the app with a PIN (no Firebase sign-in)
      allow update, delete: if true;
    }
  }
}
